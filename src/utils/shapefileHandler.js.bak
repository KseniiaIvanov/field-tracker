import JSZip from 'jszip'
import shpjs from 'shpjs'

export async function parseShapefileZip(zipFile) {
  try {
    // Parse ZIP file
    const zip = new JSZip()
    const zipData = await zipFile.arrayBuffer()
    const zipContent = await zip.loadAsync(zipData)

    // Debug: log all files in ZIP
    const zipFileNames = Object.keys(zipContent.files)
    logger.debug("shapefileHandler", 'Files in ZIP:', zipFileNames)

    // Extract required files (ignore directory structure)
    const files = {
      shp: null,
      shx: null,
      dbf: null
    }

    for (const [filepath, file] of Object.entries(zipContent.files)) {
      // Skip directories and macOS metadata
      if (file.dir) continue
      if (filepath.includes('__MACOSX') || filepath.startsWith('._')) continue

      const filename = filepath.split('/').pop().toLowerCase()
      const isShp = filename.endsWith('.shp')
      const isShx = filename.endsWith('.shx')
      const isDbf = filename.endsWith('.dbf')

      if (isShp) {
        files.shp = await file.async('arraybuffer')
        logger.debug("shapefileHandler", 'Found .shp:', filepath)
      } else if (isShx) {
        files.shx = await file.async('arraybuffer')
        logger.debug("shapefileHandler", 'Found .shx:', filepath)
      } else if (isDbf) {
        files.dbf = await file.async('arraybuffer')
        logger.debug("shapefileHandler", 'Found .dbf:', filepath)
      }
    }

    // Validate all files present
    if (!files.shp || !files.shx || !files.dbf) {
      const missing = []
      if (!files.shp) missing.push('.shp')
      if (!files.shx) missing.push('.shx')
      if (!files.dbf) missing.push('.dbf')
      throw new Error(
        `Missing required files: ${missing.join(', ')}. ` +
        `ZIP contains: ${zipFileNames.filter(f => !f.endsWith('/')).map(f => f.split('/').pop()).join(', ')}`
      )
    }

    // Parse shapefile using correct shpjs API
    // shpjs expects an object with shp, shx, dbf as properties
    const geojson = await shpjs({
      shp: files.shp,
      shx: files.shx,
      dbf: files.dbf
    })

    // Extract first polygon feature
    const features = geojson.features || []
    const polygonFeature = features.find(f => f.geometry && (f.geometry.type === 'Polygon' || f.geometry.type === 'MultiPolygon'))

    if (!polygonFeature) {
      throw new Error('No polygon geometry found in shapefile. Ensure your shapefile contains a polygon layer.')
    }

    // Convert MultiPolygon to Polygon if needed
    let polygon = polygonFeature
    if (polygonFeature.geometry.type === 'MultiPolygon') {
      polygon = {
        type: 'Feature',
        geometry: {
          type: 'Polygon',
          coordinates: polygonFeature.geometry.coordinates[0]
        },
        properties: polygonFeature.properties
      }
    }

    // Strip Z/M dimensions and normalize coordinate format
    // Handle both array [lon, lat] and object {x, y} coordinate formats
    const normalizeCoordinates = (ring) => {
      if (!Array.isArray(ring)) return ring
      return ring.map(coord => {
        // Handle object format {x, y}
        if (coord && typeof coord === 'object' && !Array.isArray(coord) && coord.x !== undefined && coord.y !== undefined) {
          return [coord.x, coord.y]
        }
        // Handle array format [lon, lat, z, m...] - keep only first 2 elements
        if (Array.isArray(coord)) {
          return [coord[0], coord[1]]
        }
        return coord
      })
    }

    polygon.geometry.coordinates = polygon.geometry.coordinates.map(normalizeCoordinates)

    // Try to detect shapefile CRS from coordinates
    // If coordinates look like large numbers (>1000), likely UTM or projected
    const coords = polygon.geometry.coordinates[0]
    const firstLon = coords[0][0]
    const firstLat = coords[0][1]

    logger.debug("shapefileHandler", 'Shapefile geometry:', {
      coordsample: [firstLon, firstLat],
      likelyProjection: Math.abs(firstLon) > 1000 ? 'Projected (UTM/meters)' : 'Geographic (lat/lon)'
    })

    // Store CRS hint in properties for later use
    polygon.properties = polygon.properties || {}
    polygon.properties._shapefile_crs_hint = Math.abs(firstLon) > 1000 ? 'projected' : 'geographic'

    return polygon
  } catch (err) {
    const msg = err.message || err.toString()
    logger.error("shapefileHandler", 'Shapefile parsing error:', err)

    if (msg.includes('signature')) {
      throw new Error('Invalid ZIP file format. Ensure you uploaded a valid ZIP archive.')
    }
    if (msg.includes('shp type') || msg.includes('geometry type') || msg.includes('Unsupported')) {
      throw new Error(
        `Shapefile parsing issue detected. ` +
        `This might be due to coordinate format or 3D data. ` +
        `Try: 1) Export as simple polygon in QGIS, 2) Simplify geometry, ` +
        `3) Or draw polygon manually on the raster instead.`
      )
    }
    throw new Error(`Shapefile parsing failed: ${msg}`)
  }
}
